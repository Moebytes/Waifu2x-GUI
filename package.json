{
  "name": "waifu2x-upscaler",
  "version": "1.0.5",
  "author": "Moebytes",
  "description": "A cute image upscaler!",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run clean && rsbuild build && npm run copy && electron dist/main/index.js",
    "build": "npm run clean ./build && rsbuild build && npm run copy && electron-builder -p never",
    "rebuild": "electron-rebuild -f -w @napi-rs/canvas",
    "copy": "node copy.ts",
    "prune": "node prune.ts",
    "clean": "del-cli ./dist"
  },
  "keywords": [
    "waifu2x",
    "upscaler",
    "anime"
  ],
  "repository": "https://github.com/Moebytes/Waifu2x-Upscaler",
  "privacyPolicy": "https://moebytes.com/privacy-policy",
  "license": "CC BY-NC 4.0",
  "build": {
    "appId": "com.moebytes.waifu2x-upscaler",
    "productName": "Waifu2x Upscaler",
    "directories": {
      "buildResources": "assets",
      "output": "build"
    },
    "buildDependenciesFromSource": true,
    "electronLanguages": ["en"],
    "afterPack": "./afterpack.js",
    "mac": {
      "icon": "assets/mas/icon.icns",
      "target": {
        "target": "mas",
        "arch": "arm64"
      },
      "type": "distribution",
      "provisioningProfile": "assets/mas/MacAppStore.provisionprofile",
      "category": "public.app-category.utilities",
      "extraFiles": [
        "ffmpeg/ffmpeg.app",
        "models"
      ]
    },
    "mas": {
      "entitlements": "assets/mas/entitlements.mas.plist",
      "entitlementsInherit": "assets/mas/entitlements.mas.inherit.plist",
      "binaries": [
        "ffmpeg/ffmpeg.app"
      ]
    },
    "dmg": {
      "title": "${productName}",
      "background": "./assets/background.png",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "assets/appx/icon.ico",
      "target": {
        "target": "appx",
        "arch": "x64"
      },
      "extraFiles": [
        "ffmpeg/ffmpeg.exe",
        "models"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Waifu2x Upscaler",
      "createDesktopShortcut": "always",
      "installerSidebar": "./assets/installer.bmp",
      "uninstallerSidebar": "./assets/installer.bmp"
    },
    "appx": {
      "identityName": "Moebytes.Waifu2xUpscaler",
      "publisher": "CN=4C1B763B-CF01-4978-8749-986F562173D8",
      "publisherDisplayName": "Moebytes",
      "capabilities": [
        "runFullTrust"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": {
        "target": "appImage",
        "arch": "x64"
      },
      "category": "Utility",
      "extraFiles": [
        "ffmpeg/ffmpeg",
        "models"
      ]
    },
    "files": [
      "dist/**/*",
      "**/*.dll",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/waifu2x",
      "node_modules/rife-fps"
    ]
  },
  "devDependencies": {
    "@electron-rsbuild/plugin-main": "^0.0.12",
    "@electron-rsbuild/plugin-preload": "^0.0.12",
    "@electron-rsbuild/plugin-renderer": "^0.0.12",
    "@electron/rebuild": "^4.0.3",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-less": "^1.6.0",
    "@rsbuild/plugin-node-polyfill": "^1.4.4",
    "@rsbuild/plugin-react": "^1.4.5",
    "@rsbuild/plugin-type-check": "^1.3.3",
    "@svgr/webpack": "^8.1.0",
    "@types/electron-localshortcut": "^3.1.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "bootstrap": "^5.3.8",
    "electron-click-drag-plugin": "^2.0.2",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^8.0.0",
    "images-meta": "github:Moestash/images-meta",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-sortablejs": "^6.1.4",
    "shade-blend-color": "^1.0.0",
    "sharp": "^0.34.5",
    "waifu2x": "^1.6.5"
  }
}
